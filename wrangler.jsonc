{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksn-budget",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "ksn-budget-data"
    }
  ]
}
